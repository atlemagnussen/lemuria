<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- PostgresProvider splits scripts into statements itself; stop Npgsql from re-splitting them on
         semicolons (that breaks CREATE FUNCTION ... BEGIN ATOMIC bodies). No @named parameters are used. -->
    <RuntimeHostConfigurationOption Include="Npgsql.EnableSqlRewriting" Value="false" />
  </ItemGroup>

  <PropertyGroup>
    <WebClientRoot>..\Lemuria.Client\</WebClientRoot>
  </PropertyGroup>

  <!-- `dotnet publish` builds the Lit/Vite client into wwwroot/app so the output is self-contained.
       Pass -p:SkipWebClientBuild=true when wwwroot/app was already built (e.g. by the Containerfile node stage). -->
  <Target Name="BuildWebClient" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(WebClientRoot)" Command="npm ci" Condition="'$(SkipWebClientBuild)' != 'true' And !Exists('$(WebClientRoot)node_modules')" />
    <Exec WorkingDirectory="$(WebClientRoot)" Command="npm run build" Condition="'$(SkipWebClientBuild)' != 'true'" />
    <ItemGroup>
      <ClientDist Include="wwwroot\app\**" />
      <ResolvedFileToPublish Include="@(ClientDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(ClientDist.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
