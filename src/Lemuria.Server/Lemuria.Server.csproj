<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <WebClientRoot>..\OpenQuery.Web\</WebClientRoot>
  </PropertyGroup>

  <!-- `dotnet publish` builds the Lit/Vite client into wwwroot/app so the output is self-contained. -->
  <Target Name="BuildWebClient" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(WebClientRoot)" Command="npm ci" Condition="!Exists('$(WebClientRoot)node_modules')" />
    <Exec WorkingDirectory="$(WebClientRoot)" Command="npm run build" />
    <ItemGroup>
      <ClientDist Include="wwwroot\app\**" />
      <ResolvedFileToPublish Include="@(ClientDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(ClientDist.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
